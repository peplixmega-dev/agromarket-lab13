# Локальный запуск. Скопируйте в .env и подставьте свои значения.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/agromarket
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=2h
# Можно использовать CORS_ORIGINS; при наличии он имеет приоритет.
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Нужны для db:init; db:migrate без них не создаёт администратора.
ADMIN_EMAIL=admin@agromarket.kz
ADMIN_PASSWORD=CHANGE_ME_use_a_long_unique_password
