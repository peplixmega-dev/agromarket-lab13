# Необязательно: учётная запись admin ТОЛЬКО для автоматически создаваемой локальной БД.
# По умолчанию Playwright генерирует пароль на каждый запуск и передаёт его сиду.
# Скопируйте в .env.e2e и задайте собственные тестовые значения при необходимости.
# Не используйте учётные данные продакшена.
# E2E_ADMIN_EMAIL=e2e-admin@agromarket.test
# E2E_ADMIN_PASSWORD=local-test-password-at-least-8-characters
